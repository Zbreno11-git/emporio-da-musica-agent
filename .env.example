# Copy to .env and fill in locally. Never commit .env.
# On the Cloud Run demo, GEMINI_API_KEY and ADMIN_TOKEN come from Secret Manager.

# Gemini (key from Google AI Studio). The model is pinned by the benchmark (docs/DECISIONS.md, D14).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# /admin numbers (D20). Any long random string, e.g.
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty: /admin/api/stats always answers 404.
ADMIN_TOKEN=

# Optional (defaults shown)
APP_TIMEZONE=America/Campo_Grande
CHAT_TIMEOUT_S=25
MAX_TURNS_PER_DAY=400
# 1 shows each answer's tool calls in the page's technical panel (demo for evaluators); use 0 with real customers (D23)
EXPOSE_TRACE=1

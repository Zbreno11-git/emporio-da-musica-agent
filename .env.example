# Copie para .env e preencha localmente. Nunca faça commit do .env.
# Na demo do Cloud Run, a chave vem do Secret Manager.

# Gemini
GEMINI_API_KEY=
# ID explícito do modelo, fixado depois do smoke test e do benchmark (docs/DECISOES.md, D2)
GEMINI_MODEL=

# Busca nas políticas: lexical | semantic
POLICY_RETRIEVER=lexical
EMBEDDING_MODEL=

# Aplicação
APP_TIMEZONE=America/Campo_Grande
CHAT_TIMEOUT_S=25
PORT=8000

# Copy to .env and fill in locally. Never commit .env.
# On the Cloud Run demo, the key comes from Secret Manager.

# Gemini
GEMINI_API_KEY=
# Explicit model ID, pinned after the smoke test and the benchmark (docs/DECISIONS.md, D2/D14)
GEMINI_MODEL=

# Policy retrieval: lexical | semantic
POLICY_RETRIEVER=lexical
EMBEDDING_MODEL=

# Application
APP_TIMEZONE=America/Campo_Grande
CHAT_TIMEOUT_S=25
PORT=8000
